rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MedStore Server backend uses Firebase Admin SDK which bypasses security rules.
    // Client-side access rules:
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /sales/{saleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
